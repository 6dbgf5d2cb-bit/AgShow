page {
  height: 100%;
  background: #f5f5f5;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  padding-top: calc(env(safe-area-inset-top) + 24rpx);
  background: #fff;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #333;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.placeholder {
  width: 64rpx;
}

.featured-picker {
  margin: 0 32rpx 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
}

.featured-picker .muted {
  color: #999;
}

.picker-arrow {
  color: #999;
  font-size: 24rpx;
}

.config-section {
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.section-header {
  display: flex;
  flex-direction: column;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.section-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.config-scroll {
  flex: 1;
  padding: 24rpx;
  padding-bottom: calc(24rpx + 100rpx + env(safe-area-inset-bottom) + 200rpx);
}

.config-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.config-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.config-info {
  display: flex;
  flex-direction: column;
}

.config-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.config-id {
  font-size: 24rpx;
  color: #999;
}

.toggle-switch {
  width: 100rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #ccc;
  position: relative;
  transition: background 0.3s;
}

.toggle-switch.on {
  background: #667eea;
}

.toggle-thumb {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #fff;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: left 0.3s;
}

.toggle-switch.on .toggle-thumb {
  left: 48rpx;
}

.permission-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.permission-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.permission-item.active {
  background: #1a1a2e;
  border: 2rpx solid #16213e;
}

.permission-item.active .permission-label {
  color: #fff;
  font-weight: bold;
}

.permission-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.permission-label {
  font-size: 24rpx;
  color: #999;
}

/* 保存按钮：导航栏上方再抬高约两行（80rpx） */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom) + 80rpx) !important;
  z-index: 9998;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  background: #667eea;
  border-radius: 48rpx;
  border: none;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}
