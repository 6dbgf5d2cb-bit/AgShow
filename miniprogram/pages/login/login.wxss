page {
  height: 100%;
  background: #667eea;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
  padding-bottom: 80rpx;
}

.logo {
  width: 180rpx;
  height: 180rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.logo-text {
  font-size: 52rpx;
  font-weight: bold;
  color: #fff;
}

.slogan {
  font-size: 34rpx;
  color: rgba(255, 255, 255, 0.95);
}

.form-section-wrapper {
  flex: 1;
  padding: 0 40rpx;
}

.form-section {
  background: #fff;
  border-radius: 28rpx;
  padding: 56rpx 40rpx;
}

.input-item {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 0 28rpx;
  margin-bottom: 28rpx;
  height: 100rpx;
}

.input-icon {
  width: 56rpx;
  display: flex;
  justify-content: center;
}

.icon {
  font-size: 36rpx;
}

.input-field {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  color: #333;
  background: transparent;
}

.input-action {
  width: 56rpx;
  display: flex;
  justify-content: center;
}

.error-message {
  color: #ff4d4f;
  font-size: 26rpx;
  margin-bottom: 28rpx;
  padding-left: 8rpx;
}

.form-options {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 36rpx;
}

.checkbox-item {
  display: flex;
  align-items: center;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.checkbox.checked {
  background: #667eea;
  border-color: #667eea;
}

.check-icon {
  color: #fff;
  font-size: 24rpx;
}

.checkbox-text {
  font-size: 28rpx;
  color: #666;
}

.forgot-link {
  font-size: 28rpx;
  color: #667eea;
}

.quick-login {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.btn-wechat,
.btn-phone {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  padding: 0;
  margin: 0;
  line-height: 96rpx;
}

.btn-wechat::after,
.btn-phone::after {
  border: none;
}

.btn-wechat {
  background: #07c160;
  color: #fff;
}

.btn-phone {
  background: #667eea;
  color: #fff;
}

.phone-fallback {
  text-align: center;
  padding: 16rpx 0 8rpx;
  font-size: 26rpx;
  color: #667eea;
}

.privacy-tip {
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: #ad6800;
  line-height: 1.5;
}

.btn-icon {
  font-size: 36rpx;
}

.quick-hint {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  margin-top: 8rpx;
  line-height: 1.5;
}

.phone-modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.phone-modal {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
}

.phone-modal-title {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.phone-modal-desc {
  display: block;
  font-size: 26rpx;
  color: #888;
  margin-bottom: 32rpx;
}

.phone-modal-input {
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  margin-bottom: 32rpx;
}

.phone-modal-actions {
  display: flex;
  gap: 24rpx;
}

.phone-modal-cancel,
.phone-modal-confirm {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  margin: 0;
  padding: 0;
}

.phone-modal-cancel::after,
.phone-modal-confirm::after {
  border: none;
}

.phone-modal-cancel {
  background: #f0f0f0;
  color: #666;
}

.phone-modal-confirm {
  background: #667eea;
  color: #fff;
}

.divider {
  display: flex;
  align-items: center;
  margin: 36rpx 0 28rpx;
  gap: 20rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #eee;
}

.divider-text {
  font-size: 26rpx;
  color: #bbb;
}

.account-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0 24rpx;
  font-size: 28rpx;
  color: #667eea;
}

.toggle-arrow {
  font-size: 22rpx;
}

.account-login {
  padding-top: 8rpx;
}

.btn-primary {
  width: 100%;
  height: 100rpx;
  background: #667eea;
  border-radius: 50rpx;
  border: none;
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 36rpx;
}

.register-link {
  display: flex;
  justify-content: center;
  align-items: center;
}

.register-link text {
  font-size: 28rpx;
  color: #888;
}

.register-link .link {
  color: #667eea;
  margin-left: 12rpx;
  font-weight: 500;
}

.footer {
  text-align: center;
  padding: 40rpx 0;
}

.footer text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}
