page {
  height: 100%;
  margin: 0;
  padding: 0;
}

.container {
  min-height: 100vh;
  height: 100%;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: calc(env(safe-area-inset-top) + 24rpx);
  padding-bottom: 24rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  background: #fff;
  flex-shrink: 0;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #333;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.placeholder {
  width: 64rpx;
}

.form-scroll {
  flex: 1;
  overflow-y: auto;
}

.form-section {
  padding: 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 32rpx);
}

.form-group {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.form-group.required {
  border: 2rpx solid #667eea;
}

.group-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.required-mark {
  color: #ff4d4f;
  margin-right: 8rpx;
}

.optional-hint {
  font-weight: normal;
  color: #999;
  margin-left: 8rpx;
}

.input-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.input-item:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.input-action {
  width: 48rpx;
  display: flex;
  justify-content: center;
}

.gender-options {
  flex: 1;
  display: flex;
  gap: 24rpx;
}

.gender-option {
  flex: 1;
  height: 72rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #666;
}

.gender-option.active {
  border-color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  color: #667eea;
}

.picker-value {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.arrow {
  color: #999;
  font-size: 32rpx;
}

.error-message {
  color: #ff4d4f;
  font-size: 24rpx;
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: rgba(255, 77, 79, 0.1);
  border-radius: 8rpx;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  background: #667eea;
  border-radius: 48rpx;
  border: none;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 32rpx;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-primary[disabled] {
  opacity: 0.6;
}

.login-link {
  display: flex;
  justify-content: center;
  align-items: center;
}

.login-link text {
  font-size: 26rpx;
  color: #999;
}

.login-link .link {
  color: #667eea;
  margin-left: 8rpx;
}
