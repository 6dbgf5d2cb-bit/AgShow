page {
  height: 100%;
  background: #f5f5f5;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  padding-top: calc(env(safe-area-inset-top) + 24rpx);
  background: #fff;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #333;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.placeholder {
  width: 64rpx;
}

.content-actions {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  padding: 16rpx 48rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
}

.action-btn.edit {
  background: rgba(102, 126, 234, 0.1);
  color: #667eea;
}

.action-btn.delete {
  background: rgba(255, 77, 79, 0.1);
  color: #ff4d4f;
}

.detail-scroll {
  flex: 1;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom) + 160rpx);
}

.cover-section {
  position: relative;
  height: 400rpx;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
}

.difficulty-badge {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #fff;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.route-gallery-image {
  width: calc(33.33% - 8rpx);
  height: 200rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.main-section {
  padding: 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 48rpx);
}

.route-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.meta-bar {
  display: flex;
  gap: 32rpx;
  margin-bottom: 20rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
}

.meta-icon {
  margin-right: 8rpx;
}

.tags-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tag {
  padding: 8rpx 20rpx;
  background: rgba(102, 126, 234, 0.1);
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #667eea;
}

.section-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.route-path-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  position: relative;
}

.path-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.path-dot.start {
  background: #52c41a;
}

.path-dot.waypoint {
  background: #faad14;
}

.path-dot.end {
  background: #ff4d4f;
}

.path-line {
  position: absolute;
  left: 11rpx;
  top: 24rpx;
  width: 2rpx;
  height: 40rpx;
  background: #e0e0e0;
}

.route-path-item:last-child .path-line {
  display: none;
}

.path-text {
  font-size: 26rpx;
  color: #666;
}

.season-list {
  display: flex;
  gap: 16rpx;
}

.season-tag {
  padding: 12rpx 24rpx;
  background: rgba(82, 196, 26, 0.1);
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #52c41a;
}

.publisher-card {
  background: #fff;
}

.publisher-info {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.publisher-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.publisher-detail {
  flex: 1;
}

.publisher-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.publisher-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.level-badge {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  color: #fff;
}

.publish-time {
  font-size: 24rpx;
  color: #999;
}

.phone-section {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.phone-visible {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: rgba(82, 196, 26, 0.1);
  border-radius: 12rpx;
}

.phone-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.phone-number {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.phone-hint {
  font-size: 24rpx;
  color: #52c41a;
}

.phone-hidden {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.phone-icon.locked {
  font-size: 36rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.phone-upgrade {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.upgrade-text {
  font-size: 26rpx;
  color: #999;
}

.upgrade-btn {
  font-size: 26rpx;
  color: #667eea;
}

.participant-count {
  display: flex;
  align-items: baseline;
  padding: 16rpx 0;
}

.count-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #667eea;
}

.count-divider {
  font-size: 32rpx;
  color: #ddd;
  margin: 0 8rpx;
}

.count-total {
  font-size: 28rpx;
  color: #999;
}

.participant-list {
  padding-top: 16rpx;
}

.participant-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.participant-item:last-child {
  border-bottom: none;
}

.participant-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.participant-info {
  flex: 1;
}

.participant-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.participant-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.participant-time {
  font-size: 24rpx;
  color: #999;
}

.participant-phone {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(102, 126, 234, 0.1);
  border-radius: 20rpx;
}

.participant-phone .phone-icon {
  font-size: 28rpx;
}

.phone-text {
  font-size: 24rpx;
  color: #667eea;
}

/* 报名栏：导航栏上方抬高约一行（48rpx） */
.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom) + 48rpx) !important;
  z-index: 9998;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.participant-info-bar {
  flex: 1;
}

.participant-text {
  font-size: 26rpx;
  color: #666;
}

.sign-up-btn {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 44rpx;
  border: none;
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
}

.sign-up-btn[disabled] {
  background: #ccc;
}

.signed-badge {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(82, 196, 26, 0.1);
  border-radius: 44rpx;
}

.signed-badge text {
  font-size: 30rpx;
  font-weight: bold;
  color: #52c41a;
}

.login-hint {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-hint text {
  font-size: 28rpx;
  color: #999;
}

.level-badge.small {
  padding: 4rpx 10rpx;
  font-size: 20rpx;
}
