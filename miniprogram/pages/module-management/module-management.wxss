page {
  height: 100%;
  background: #f5f5f5;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  padding-top: calc(env(safe-area-inset-top) + 24rpx);
  background: #fff;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #333;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.placeholder {
  width: 64rpx;
}

.module-scroll {
  flex: 1;
  padding: 24rpx;
  padding-bottom: calc(24rpx + 100rpx + env(safe-area-inset-bottom) + 200rpx);
}

.module-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.module-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.module-info {
  display: flex;
  align-items: center;
}

.module-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.module-text {
  display: flex;
  flex-direction: column;
}

.module-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.module-id {
  font-size: 24rpx;
  color: #999;
}

.toggle-switch {
  width: 100rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #ccc;
  position: relative;
  transition: background 0.3s;
}

.toggle-switch.on {
  background: #667eea;
}

.toggle-thumb {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #fff;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: left 0.3s;
}

.toggle-switch.on .toggle-thumb {
  left: 48rpx;
}

.permission-section {
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.permission-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.permission-row {
  display: flex;
  align-items: center;
  width: calc(50% - 8rpx);
}

.permission-label {
  flex: 1;
  font-size: 26rpx;
  color: #666;
}

.permission-switch {
  width: 64rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: #eee;
  position: relative;
}

.permission-switch.on {
  background: #52c41a;
}

.switch-thumb {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #fff;
  position: absolute;
  top: 2rpx;
  left: 2rpx;
}

.permission-switch.on .switch-thumb {
  left: 30rpx;
}

/* 保存按钮：导航栏上方再抬高约两行（80rpx） */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom) + 80rpx) !important;
  z-index: 9998;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  background: #667eea;
  border-radius: 48rpx;
  border: none;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}
