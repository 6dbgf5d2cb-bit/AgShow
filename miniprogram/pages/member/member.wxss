.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  padding: 0 0 40rpx;
  color: #fff;
}

.user-card {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
}

.level-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.username {
  font-size: 26rpx;
  opacity: 0.8;
}

.guest-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.btn-login,
.btn-register {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  border-radius: 36rpx;
}

.btn-login {
  background: #fff;
  color: #667eea;
}

.btn-register {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}

.guest .arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.8);
}

.home-link {
  font-size: 28rpx;
  color: #1677ff;
  padding: 0 16rpx;
}

.admin-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.admin-row {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.admin-row:last-child {
  border-bottom: none;
}

.admin-row-icon {
  font-size: 40rpx;
}

.admin-row-body {
  flex: 1;
  margin: 0 20rpx;
}

.admin-row-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.admin-row-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999;
}

.admin-quick {
  margin-top: 20rpx;
}

.tab-spacer {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

.footer-section {
  padding: 24rpx;
  padding-bottom: 24rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background: #fff;
  border: 2rpx solid #ddd;
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #666;
}

.points-card {
  display: flex;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 24rpx;
}

.points-info, .status-info, .role-info {
  flex: 1;
  text-align: center;
}

.points-value, .status-value, .role-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
}

.points-label, .status-label, .role-label {
  font-size: 22rpx;
  opacity: 0.8;
}

.divider {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.3);
}

.menu-section {
  padding: 24rpx;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 0;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.menu-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.menu-text {
  font-size: 24rpx;
  color: #666;
}

.admin-section {
  padding: 0 24rpx 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.admin-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 0;
}

.admin-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
}

.admin-icon {
  width: 72rpx;
  height: 72rpx;
  background: rgba(102, 126, 234, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.admin-text {
  font-size: 22rpx;
  color: #333;
}

.info-section {
  padding: 0 24rpx 24rpx;
}

.info-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #333;
}

.privileges-section {
  padding: 0 24rpx 48rpx;
}

.privileges-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.privilege-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.privilege-check {
  width: 36rpx;
  height: 36rpx;
  background: #52c41a;
  border-radius: 50%;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.privilege-text {
  font-size: 26rpx;
  color: #333;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 32rpx;
  font-weight: bold;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999;
}

.modal-body {
  padding: 32rpx;
}

.level-option, .role-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #e0e0e0;
}

.level-option.active, .role-option.active {
  border-color: #667eea;
  background: rgba(102, 126, 234, 0.1);
}

.level-name, .role-name {
  font-size: 28rpx;
}

.level-check, .role-check {
  width: 40rpx;
  height: 40rpx;
  background: #667eea;
  border-radius: 50%;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx 32rpx;
}

.btn-secondary {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  border: none;
  font-size: 28rpx;
  color: #666;
}

.btn-primary {
  flex: 1;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 40rpx;
  border: none;
  font-size: 28rpx;
  color: #fff;
}