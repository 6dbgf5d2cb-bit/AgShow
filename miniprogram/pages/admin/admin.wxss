.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  padding-bottom: 120rpx;
}

/* 顶栏由 page-header 组件承担 */

.header .title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.2);
}

.admin-avatar {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  font-size: 36rpx;
}

.stats-section {
  display: flex;
  padding: 0 24rpx;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  text-align: center;
  backdrop-filter: blur(10px);
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.menu-section {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  padding: 24rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.menu-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.menu-item {
  width: calc(50% - 8rpx);
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  transition: all 0.3s;
  border: 2rpx solid transparent;
}

.menu-item:active,
.menu-item.active {
  transform: scale(0.98);
  background: #4a5568;
  border-color: #2d3748;
}

.menu-item:active .menu-text,
.menu-item.active .menu-text {
  color: #fff;
}

.menu-item:active .menu-desc,
.menu-item.active .menu-desc {
  color: rgba(255, 255, 255, 0.8);
}

.menu-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.menu-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.menu-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.quick-actions {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  padding: 24rpx;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.action-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  transition: all 0.3s;
  border: 2rpx solid transparent;
}

.action-item:active,
.action-item.active {
  background: #4a5568;
  border-color: #2d3748;
}

.action-item:active .action-text,
.action-item.active .action-text {
  color: #fff;
}

.action-item:active .action-arrow,
.action-item.active .action-arrow {
  color: rgba(255, 255, 255, 0.8);
}

.action-item.danger {
  background: rgba(255, 77, 79, 0.15);
  border-color: rgba(255, 77, 79, 0.3);
}

.action-item.danger .action-text {
  color: #c53030;
}

.action-item.danger:active {
  background: #c53030;
}

.action-item.danger:active .action-text {
  color: #fff;
}

.action-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.action-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.action-arrow {
  font-size: 28rpx;
  color: #999;
}

.footer-space {
  height: 40rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  padding: 16rpx 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 16rpx);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.nav-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4);
}

.nav-icon {
  font-size: 36rpx;
}

.nav-text {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.nav-item.active .nav-text {
  color: #fff;
  font-weight: bold;
}

.nav-item.active .nav-icon {
  filter: brightness(1.2);
}