page {
  height: 100%;
  background: #f5f5f5;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  padding-top: calc(env(safe-area-inset-top) + 24rpx);
  background: #fff;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #333;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.placeholder {
  width: 64rpx;
}

.form-scroll {
  flex: 1;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom) + 160rpx);
}

.form-section {
  padding: 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 48rpx);
}

.form-group {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.form-group.half {
  flex: 1;
  margin-bottom: 0;
}

.form-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: bold;
}

.form-label.required::before {
  content: '*';
  color: #ff4d4f;
  margin-right: 8rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.form-textarea.small {
  min-height: 120rpx;
}

.difficulty-options {
  display: flex;
  gap: 24rpx;
}

.difficulty-option {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
}

.difficulty-option.active {
  border-color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  color: #667eea;
}

.season-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.season-option {
  padding: 16rpx 32rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666;
}

.season-option.active {
  border-color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  color: #667eea;
}

.tag-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-option {
  padding: 12rpx 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.tag-option.active {
  border-color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  color: #667eea;
}

.image-upload-section {
  margin-top: 16rpx;
}

.cover-image-section {
  margin-bottom: 24rpx;
}

.upload-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.upload-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border: 2rpx dashed #ddd;
  border-radius: 16rpx;
}

.upload-box.cover {
  width: 100%;
  height: 300rpx;
}

.upload-box.small {
  width: 200rpx;
  height: 200rpx;
}

.upload-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

.cover-preview {
  position: relative;
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.image-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-overlay text {
  font-size: 28rpx;
  color: #fff;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.grid-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.delete-btn {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: #ff4d4f;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-btn text {
  font-size: 28rpx;
  color: #fff;
}

.error-message {
  padding: 20rpx;
  background: rgba(255, 77, 79, 0.1);
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.error-message text {
  font-size: 26rpx;
  color: #ff4d4f;
}

.bottom-spacing {
  height: 32rpx;
}

/* 发布按钮：导航栏上方抬高约一行（48rpx） */
.bottom-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom) + 48rpx) !important;
  z-index: 9998;
  padding: 20rpx 32rpx;
  display: flex;
  justify-content: center;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.publish-btn {
  width: 100%;
  max-width: 640rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 48rpx;
  border: none;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin: 0;
  padding: 0;
}

.publish-btn::after {
  border: none;
}

.publish-btn[disabled] {
  opacity: 0.6;
}
