<view class="container">
  <page-header bind:back="goBack" title="{{isEdit ? '编辑线路' : '发布线路'}}" />

  <scroll-view class="form-scroll" scroll-y>
    <view class="form-section">
      <view class="form-group">
        <text class="form-label required">线路名称</text>
        <input 
          class="form-input" 
          placeholder="请输入线路名称"
          value="{{title}}"
          bindinput="onInputChange"
          data-field="title"
        />
      </view>

      <view class="form-group">
        <text class="form-label required">线路描述</text>
        <textarea 
          class="form-textarea" 
          placeholder="请详细描述这条线路的特色和亮点"
          value="{{description}}"
          bindinput="onInputChange"
          data-field="description"
        />
      </view>

      <view class="form-group">
        <text class="form-label required">起点</text>
        <input 
          class="form-input" 
          placeholder="请输入出发地点"
          value="{{startPoint}}"
          bindinput="onInputChange"
          data-field="startPoint"
        />
      </view>

      <view class="form-group">
        <text class="form-label required">终点</text>
        <input 
          class="form-input" 
          placeholder="请输入目的地"
          value="{{endPoint}}"
          bindinput="onInputChange"
          data-field="endPoint"
        />
      </view>

      <view class="form-group">
        <text class="form-label">途经点（每行一个）</text>
        <textarea 
          class="form-textarea small" 
          placeholder="请输入途经点，每行一个"
          value="{{waypointsText}}"
          bindinput="onWaypointsInput"
        />
      </view>

      <view class="form-row">
        <view class="form-group half">
          <text class="form-label">预计里程(km)</text>
          <input 
            class="form-input" 
            placeholder="里程"
            value="{{distance}}"
            bindinput="onInputChange"
            data-field="distance"
            type="number"
          />
        </view>
        <view class="form-group half">
          <text class="form-label">预计时长(小时)</text>
          <input 
            class="form-input" 
            placeholder="时长"
            value="{{duration}}"
            bindinput="onInputChange"
            data-field="duration"
            type="number"
          />
        </view>
      </view>

      <view class="form-group">
        <text class="form-label required">总人数限制</text>
        <input 
          class="form-input" 
          placeholder="请输入最大参与人数"
          value="{{maxParticipants}}"
          bindinput="onInputChange"
          data-field="maxParticipants"
          type="number"
        />
      </view>

      <view class="form-group">
        <text class="form-label required">难度等级</text>
        <view class="difficulty-options">
          <view 
            class="difficulty-option {{difficulty === 'easy' ? 'active' : ''}}"
            bindtap="selectDifficulty"
            data-value="easy"
          >
            <text>简单</text>
          </view>
          <view 
            class="difficulty-option {{difficulty === 'medium' ? 'active' : ''}}"
            bindtap="selectDifficulty"
            data-value="medium"
          >
            <text>中等</text>
          </view>
          <view 
            class="difficulty-option {{difficulty === 'hard' ? 'active' : ''}}"
            bindtap="selectDifficulty"
            data-value="hard"
          >
            <text>困难</text>
          </view>
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">最佳季节</text>
        <view class="season-options">
          <view 
            wx:for="{{seasonOptionsWithState}}" 
            wx:key="value"
            class="season-option {{item.selected ? 'active' : ''}}"
            bindtap="toggleSeason"
            data-value="{{item.value}}"
          >
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">线路标签</text>
        <view class="tag-options">
          <view 
            wx:for="{{tagOptionsWithState}}" 
            wx:key="value"
            class="tag-option {{item.selected ? 'active' : ''}}"
            bindtap="toggleTag"
            data-value="{{item.value}}"
          >
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">线路照片</text>
        <view class="image-upload-section">
          <view class="cover-image-section">
            <text class="upload-label">封面图</text>
            <view wx:if="{{coverImage}}" class="cover-preview" bindtap="chooseCoverImage">
              <image class="cover-image" src="{{coverImage}}" mode="aspectFill" />
              <view class="image-overlay">
                <text>点击更换</text>
              </view>
            </view>
            <view wx:else class="upload-box cover" bindtap="chooseCoverImage">
              <text class="upload-icon">📷</text>
              <text class="upload-text">添加封面图</text>
            </view>
          </view>
          
          <view class="other-images-section">
            <text class="upload-label">更多照片（最多9张）</text>
            <view class="image-grid">
              <view wx:for="{{images}}" wx:key="index" class="image-item">
                <image class="grid-image" src="{{item}}" mode="aspectFill" />
                <view class="delete-btn" bindtap="deleteImage" data-index="{{index}}">
                  <text>×</text>
                </view>
              </view>
              <view wx:if="{{images.length < 9}}" class="upload-box small" bindtap="chooseImages">
                <text class="upload-icon">+</text>
                <text class="upload-text">添加照片</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">旅行贴士</text>
        <textarea 
          class="form-textarea" 
          placeholder="分享一些实用的旅行建议和注意事项"
          value="{{tips}}"
          bindinput="onInputChange"
          data-field="tips"
        />
      </view>

      <view wx:if="{{errorMessage}}" class="error-message">
        <text>{{errorMessage}}</text>
      </view>

      <view class="bottom-spacing"></view>
    </view>
  </scroll-view>

  <view class="bottom-action-bar">
    <button class="publish-btn" bindtap="onSubmit" disabled="{{loading}}">
      <text wx:if="{{loading}}">{{isEdit ? '更新中...' : '发布中...'}}</text>
      <text wx:else>{{isEdit ? '更新线路' : '发布线路'}}</text>
    </button>
  </view>

  <view class="tab-spacer"></view>
  <app-tab-bar />
</view>
