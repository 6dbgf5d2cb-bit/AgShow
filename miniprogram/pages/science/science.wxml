<view class="page">
  <page-header theme="light" title="科学尽头" showBack="{{false}}" />
  <view class="list">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="item-card"
      bindtap="onItemTap"
      data-url="{{item.url}}"
    >
      <view class="item-icon">{{item.icon}}</view>
      <view class="item-body">
        <text class="item-title">{{item.title}}</text>
        <text class="item-desc">{{item.desc}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
  <view class="tab-spacer"></view>
  <app-tab-bar active="science" />
</view>
