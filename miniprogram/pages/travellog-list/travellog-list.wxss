.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 顶栏由 page-header 组件承担 */

.action-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.action-left, .action-right {
  width: 150rpx;
}

.action-left {
  text-align: left;
}

.action-right {
  text-align: right;
}

.action-center {
  flex: 1;
  text-align: center;
}

.select-all {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  margin-right: 8rpx;
}

.checkbox.checked {
  background: #4CAF50;
  border-color: #4CAF50;
}

.check-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.manage-btn {
  font-size: 30rpx;
  color: #4CAF50;
  padding: 10rpx 24rpx;
  background: rgba(76, 175, 80, 0.1);
  border-radius: 20rpx;
}

.manage-btn.exit-btn {
  color: #ff4d4f;
  background: rgba(255, 77, 79, 0.1);
}

.batch-actions {
  display: flex;
  gap: 12rpx;
}

.batch-btn {
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
  border: 1rpx solid #ddd;
}

.delete-btn {
  background: #ff4d4f;
  color: #fff;
  border: none;
}

.log-list {
  flex: 1;
  padding: 16rpx;
  padding-bottom: calc(16rpx + 100rpx + env(safe-area-inset-bottom) + 140rpx);
  height: calc(100vh - 300rpx);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.log-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  display: flex;
  border: 4rpx solid transparent;
  transition: all 0.2s;
}

.log-card.selected {
  border-color: #4CAF50;
  background: rgba(76, 175, 80, 0.05);
}

.select-box {
  width: 60rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 16rpx;
}

.log-cover {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.log-cover image {
  width: 100%;
  height: 100%;
}

.no-image {
  width: 100%;
  height: 100%;
  background-color: #f8f8f8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.no-image-icon {
  font-size: 48rpx;
}

.log-content {
  flex: 1;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
}

.log-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.log-desc {
  font-size: 24rpx;
  color: #666;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex: 1;
}

.log-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.publisher-info {
  display: flex;
  align-items: center;
}

.publisher-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.publisher-placeholder {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 28rpx;
  margin-right: 8rpx;
}

.publisher-name {
  font-size: 22rpx;
  color: #333;
  margin-right: 6rpx;
}

.publisher-level {
  font-size: 18rpx;
  padding: 2rpx 6rpx;
  border-radius: 6rpx;
  background-color: rgba(0, 0, 0, 0.05);
}

.log-stats {
  display: flex;
}

.stat-item {
  font-size: 20rpx;
  color: #999;
  margin-left: 16rpx;
}

.log-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.log-location {
  font-size: 20rpx;
  color: #666;
}

.log-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.tag {
  font-size: 20rpx;
  color: #4CAF50;
  background-color: rgba(76, 175, 80, 0.1);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}

.bottom-spacing {
  height: 32rpx;
}

/* 在导航栏上方再抬高约一行（48rpx） */
.bottom-action-bar {
  position: fixed;
  bottom: calc(100rpx + env(safe-area-inset-bottom) + 48rpx) !important;
  left: 0;
  right: 0;
  padding: 20rpx 40rpx;
  display: flex;
  justify-content: center;
  z-index: 9998;
}

.publish-btn {
  background: linear-gradient(135deg, #4CAF50, #8BC34A);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 60rpx;
  font-size: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(76, 175, 80, 0.4);
}

.publish-tip {
  font-size: 26rpx;
  color: #999;
}