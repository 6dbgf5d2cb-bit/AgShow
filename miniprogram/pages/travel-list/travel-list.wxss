page {
  height: 100%;
  background: #f5f5f5;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 顶栏由 page-header 组件承担 */

.filter-bar {
  display: flex;
  padding: 20rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  gap: 16rpx;
}

.filter-item {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background: #f0f0f0;
  color: #666;
}

.filter-item.active {
  background: #667eea;
  color: #fff;
}

.route-list {
  flex: 1;
  padding: 24rpx;
}

.route-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.route-cover {
  position: relative;
  height: 320rpx;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 100rpx;
}

.difficulty-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #fff;
}

.route-info {
  padding: 24rpx;
}

.route-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.route-path {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.path-label {
  font-size: 24rpx;
  color: #999;
  width: 80rpx;
}

.path-value {
  font-size: 24rpx;
  color: #666;
}

.route-meta {
  display: flex;
  gap: 32rpx;
  margin: 16rpx 0;
}

.meta-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.meta-icon {
  margin-right: 8rpx;
}

.route-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag {
  padding: 6rpx 16rpx;
  background: rgba(102, 126, 234, 0.1);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #667eea;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
}

.bottom-publish-btn {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom) + 32rpx);
  left: 50%;
  transform: translateX(-50%);
  padding: 24rpx 64rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.bottom-publish-btn text {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
}
