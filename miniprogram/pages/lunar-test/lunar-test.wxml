<view class="container">
  <view class="header">
    <text class="title">农历转换测试</text>
    <text class="subtitle">验证阳历/农历转换功能</text>
  </view>

  <view class="section">
    <view class="section-title">阳历转农历</view>
    <view class="input-row">
      <input class="input" placeholder="年" data-field="solarYear" bindinput="onSolarInputChange" />
      <text class="separator">年</text>
      <input class="input" placeholder="月" data-field="solarMonth" bindinput="onSolarInputChange" />
      <text class="separator">月</text>
      <input class="input" placeholder="日" data-field="solarDay" bindinput="onSolarInputChange" />
      <text class="separator">日</text>
    </view>
    <button class="btn" bindtap="convertSolarToLunar">转换</button>
    <view class="result">{{ solarToLunarResult }}</view>
  </view>

  <view class="section">
    <view class="section-title">农历转阳历</view>
    <view class="input-row">
      <input class="input" placeholder="年" data-field="lunarYear" bindinput="onLunarInputChange" />
      <text class="separator">年</text>
      <input class="input" placeholder="月" data-field="lunarMonth" bindinput="onLunarInputChange" />
      <text class="separator">月</text>
      <input class="input" placeholder="日" data-field="lunarDay" bindinput="onLunarInputChange" />
      <text class="separator">日</text>
    </view>
    <button class="btn" bindtap="convertLunarToSolar">转换</button>
    <view class="result">{{ lunarToSolarResult }}</view>
  </view>

  <view class="section">
    <view class="section-title">自动测试结果</view>
    <button class="btn btn-secondary" bindtap="runTests">重新运行测试</button>
    <view class="test-list">
      <view 
        wx:for="{{ testResults }}" 
        wx:key="date" 
        class="test-item"
        :class="{ 'test-pass': item.isCorrect, 'test-fail': !item.isCorrect }"
      >
        <view class="test-date">{{ item.date }}</view>
        <view class="test-content">
          <text>预期: {{ item.expected }}</text>
          <text>实际: {{ item.actual }}</text>
        </view>
        <view class="test-status">{{ item.isCorrect ? '✓' : '✗' }}</view>
      </view>
    </view>
  </view>
</view>
