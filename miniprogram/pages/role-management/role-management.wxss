page {
  height: 100%;
  background: #f5f5f5;
}

.container {
  min-height: 100vh;
}

.role-header-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  width: 100%;
}

.action-btn {
  padding: 12rpx 32rpx;
  background: #667eea;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #fff;
}

.placeholder {
  width: 64rpx;
}

.role-section {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.section-hint {
  font-size: 24rpx;
  color: #999;
}

.batch-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.selected-count {
  font-size: 24rpx;
  color: #667eea;
}

.batch-btn {
  padding: 12rpx 20rpx;
  background: #f0f0f0;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.batch-btn.danger {
  background: rgba(255, 77, 79, 0.1);
  color: #ff4d4f;
}

.role-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.role-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f8f9fa;
  transition: all 0.3s;
}

.role-card.active {
  background: rgba(102, 126, 234, 0.1);
  border: 2rpx solid #667eea;
}

.checkbox-wrapper {
  margin-right: 16rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox.checked {
  background: #667eea;
  border-color: #667eea;
}

.check-icon {
  font-size: 24rpx;
  color: #fff;
}

.role-info {
  flex: 1;
}

.role-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.role-key {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.role-actions {
  display: flex;
  gap: 16rpx;
}

.action-icon {
  font-size: 32rpx;
  padding: 8rpx;
}

.action-icon.delete {
  color: #ff4d4f;
}

.permission-section {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.permission-scroll {
  max-height: 600rpx;
}

.module-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #f0f0f0;
}

.module-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.module-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.module-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.permission-grid {
  display: flex;
  gap: 16rpx;
}

.permission-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.permission-item.active {
  background: #1a1a2e;
  border-color: #16213e;
}

.permission-item.active .permission-label {
  color: #fff;
  font-weight: bold;
}

.permission-item.active .permission-icon {
  filter: brightness(1.2);
}

.permission-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.permission-label {
  font-size: 24rpx;
  color: #666;
}

.footer-bar {
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  background: #667eea;
  border-radius: 48rpx;
  border: none;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.btn-secondary {
  width: 300rpx;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 44rpx;
  border: none;
  font-size: 30rpx;
  color: #666;
}

.btn-danger {
  width: 300rpx;
  height: 88rpx;
  background: #ff4d4f;
  border-radius: 44rpx;
  border: none;
  font-size: 30rpx;
  color: #fff;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 640rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
}

.modal-footer {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-input[disabled] {
  background: #f0f0f0;
  color: #999;
}

.permission-checkboxes {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.permission-checkbox {
  padding: 12rpx 20rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.permission-checkbox.active {
  background: #667eea;
  color: #fff;
}