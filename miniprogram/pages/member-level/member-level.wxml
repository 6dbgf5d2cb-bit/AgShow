<view class="container">
  <page-header bind:back="goBack" title="会员等级管理" />

  <scroll-view class="content" scroll-y>
    <view class="level-list">
      <view wx:for="{{levels}}" wx:key="level" class="level-card">
        <view class="level-header" style="background:{{item.color}}">
          <view class="level-icon">{{item.icon}}</view>
          <view class="level-info">
            <text class="level-name">{{item.name}}</text>
            <text class="level-desc">{{item.description}}</text>
          </view>
          <view class="level-points">
            <text class="points-min">{{item.minPoints}}</text>
            <text class="points-label">积分起</text>
          </view>
        </view>

        <view class="level-body">
          <view class="section">
            <text class="section-title">特权列表</text>
            <view class="privilege-list">
              <view wx:for="{{item.privileges}}" wx:key="index" class="privilege-item">
                <text class="privilege-check">✓</text>
                <text class="privilege-text">{{item}}</text>
              </view>
            </view>
          </view>

          <view class="section">
            <text class="section-title">等级颜色</text>
            <view class="color-preview">
              <view class="color-item" style="background:{{item.color}}"></view>
              <text class="color-value">{{item.color}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="config-section">
      <view class="section-header">
        <text class="section-title">等级设置</text>
      </view>
      <view class="config-list">
        <view class="config-item">
          <text class="config-label">升级规则</text>
          <text class="config-value">积分累计</text>
          <text class="config-arrow">→</text>
        </view>
        <view class="config-item">
          <text class="config-label">降级规则</text>
          <text class="config-value">有效期1年</text>
          <text class="config-arrow">→</text>
        </view>
        <view class="config-item">
          <text class="config-label">积分获取</text>
          <text class="config-value">消费1元=1积分</text>
          <text class="config-arrow">→</text>
        </view>
      </view>
    </view>

    <view class="footer-space"></view>
  </scroll-view>

  <view class="tab-spacer"></view>
  <app-tab-bar />
</view>
