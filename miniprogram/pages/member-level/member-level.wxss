.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #fff;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
  font-size: 32rpx;
  color: #333;
}

.header .title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.placeholder {
  width: 64rpx;
}

.content {
  height: calc(100vh - 100rpx);
  padding: 24rpx;
}

.level-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.level-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.level-header {
  display: flex;
  align-items: center;
  padding: 24rpx;
  color: #fff;
}

.level-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.level-info {
  flex: 1;
}

.level-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
}

.level-desc {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

.level-points {
  text-align: right;
}

.points-min {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
}

.points-label {
  display: block;
  font-size: 22rpx;
  opacity: 0.9;
}

.level-body {
  padding: 24rpx;
}

.section {
  margin-bottom: 24rpx;
}

.section:last-child {
  margin-bottom: 0;
}

.section-title {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.privilege-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.privilege-item {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background: #f8f9fa;
  border-radius: 20rpx;
}

.privilege-check {
  font-size: 24rpx;
  color: #52c41a;
  margin-right: 8rpx;
}

.privilege-text {
  font-size: 24rpx;
  color: #666;
}

.color-preview {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.color-item {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  border: 2rpx solid #eee;
}

.color-value {
  font-size: 26rpx;
  color: #666;
  font-family: monospace;
}

.config-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 24rpx;
}

.config-list {
  display: flex;
  flex-direction: column;
}

.config-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.config-item:last-child {
  border-bottom: none;
}

.config-label {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.config-value {
  font-size: 28rpx;
  color: #666;
  margin-right: 12rpx;
}

.config-arrow {
  font-size: 28rpx;
  color: #999;
}

.footer-space {
  height: 40rpx;
}