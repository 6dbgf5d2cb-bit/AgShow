.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.status-bar-placeholder {
  height: calc(env(safe-area-inset-top) + 24rpx);
}

.user-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.avatar.placeholder {
  background: #e8ecf4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #666;
  text-align: center;
  padding: 8rpx;
}

.user-meta {
  flex: 1;
  margin-left: 24rpx;
}

.user-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
}

.user-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.arrow {
  font-size: 40rpx;
  color: #ccc;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.featured-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.featured-tag {
  font-size: 22rpx;
  color: #1677ff;
}

.featured-title {
  display: block;
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.featured-excerpt {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.featured-empty .featured-label {
  font-size: 28rpx;
  color: #333;
}

.featured-tip {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.quick-row {
  display: flex;
  gap: 20rpx;
}

.quick-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.quick-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 16rpx;
}

.quick-icon.blue {
  background: #e8f1ff;
}

.quick-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.quick-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.link-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.link-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.link-icon.blue-soft {
  background: #e8f1ff;
}

.link-body {
  flex: 1;
  margin: 0 20rpx;
  min-width: 0;
}

.link-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.link-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.45;
}
