.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.content--with-fixed-header {
  margin-top: calc(env(safe-area-inset-top) + 176rpx);
}

.content {
  padding-top: 100rpx;
  padding-bottom: 40rpx;
  height: 100vh;
}

.error-message {
  background-color: #fff3f0;
  padding: 16rpx 20rpx;
  margin: 20rpx;
  border-radius: 8rpx;
}

.error-message text {
  font-size: 26rpx;
  color: #ff4d4f;
}

.form-item {
  background: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 72rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 300rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.upload-area {
  display: flex;
  flex-wrap: wrap;
}

.upload-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.upload-item image, .upload-item video {
  width: 100%;
  height: 100%;
}

.remove-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 32rpx;
}

.upload-add {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed #ddd;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 24rpx;
  color: #999;
}

.upload-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.form-switch {
  transform: scale(0.8);
}

.bottom-action-bar {
  padding: 20rpx 40rpx;
  display: flex;
  justify-content: center;
}

.publish-btn {
  background: linear-gradient(135deg, #4CAF50, #8BC34A);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 80rpx;
  font-size: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(76, 175, 80, 0.4);
}