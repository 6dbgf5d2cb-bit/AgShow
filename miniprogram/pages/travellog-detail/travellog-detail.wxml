<view wx:if="{{log}}" class="container">
  <view class="header">
    <view class="header-left" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    
    <view class="header-center">
      <text class="header-title">旅行记详情</text>
    </view>
    
    <view class="header-right">
      <view wx:if="{{isPublisher || isAdmin}}" class="comment-toggle" bindtap="toggleComments">
        <text>{{allowComments ? '🔒' : '🔓'}}</text>
      </view>
    </view>
  </view>

  <view class="action-bar">
    <view class="action-left"></view>
    <view class="action-center">
      <view wx:if="{{isPublisher || isAdmin}}" class="header-actions">
        <button class="action-btn edit-btn" bindtap="editLog">编辑</button>
        <button class="action-btn delete-btn" bindtap="deleteLog">删除</button>
      </view>
    </view>
    <view class="action-right"></view>
  </view>

  <scroll-view scroll-y class="content">
    <view class="log-header">
      <text class="log-title">{{log.title}}</text>
      
      <view class="publisher-bar">
        <image wx:if="{{publisherInfo.avatarUrl}}" src="{{publisherInfo.avatarUrl}}" class="publisher-avatar" bindtap="viewPublisherProfile" />
        <text wx:else class="publisher-placeholder" bindtap="viewPublisherProfile">👤</text>
        <view class="publisher-info">
          <text class="publisher-name">{{publisherInfo.nickname}}</text>
          <text class="publisher-level" style="color: {{publisherLevelColor}}">{{publisherLevelName}}</text>
        </view>
        <button wx:if="{{canViewPhone && publisherInfo.phone}}" class="contact-btn" bindtap="makePhoneCall">联系作者</button>
      </view>
      
      <view class="log-meta">
        <text class="publish-time">{{publishTime}}</text>
        <text wx:if="{{log.location}}" class="log-location">📍 {{log.location}}</text>
      </view>
    </view>

    <view wx:if="{{log.images && log.images.length > 0}}" class="image-grid">
      <image 
        wx:for="{{log.images}}" 
        wx:key="index" 
        src="{{item}}" 
        mode="widthFix" 
        class="log-image"
        bindtap="previewImage"
        data-index="{{index}}"
      />
    </view>

    <view wx:if="{{log.videos && log.videos.length > 0}}" class="video-list">
      <video 
        wx:for="{{log.videos}}" 
        wx:key="index" 
        src="{{item}}" 
        class="log-video"
        controls
      />
    </view>

    <view class="log-content">
      <text>{{log.content}}</text>
    </view>

    <view class="log-tags">
      <text wx:for="{{log.tags}}" wx:key="*this" class="tag">{{item}}</text>
    </view>

    <view class="stats-bar">
      <text class="stat-item">👁️ {{log.viewCount}}</text>
      <view class="stat-item like-item" bindtap="onLike">
        <text class="like-icon">{{liked ? '❤️' : '🤍'}}</text>
        <text>{{log.likeCount}}</text>
      </view>
      <text class="stat-item">💬 {{log.commentCount}}</text>
    </view>

    <view class="comments-section">
      <view class="comments-header">
        <text class="comments-title">评论区</text>
        <text wx:if="{{!allowComments}}" class="comments-status">已关闭</text>
      </view>

      <view wx:if="{{comments.length === 0}}" class="no-comments">
        <text>暂无评论</text>
      </view>

      <view wx:for="{{comments}}" wx:key="commentId" class="comment-item">
        <image wx:if="{{getUserAvatar(item.authorId)}}" src="{{getUserAvatar(item.authorId)}}" class="comment-avatar" />
        <text wx:else class="comment-placeholder">👤</text>
        <view class="comment-content">
          <view class="comment-header">
            <text class="comment-author">{{item.authorName}}</text>
            <text class="comment-time">{{formatCommentTime(item.createTime)}}</text>
          </view>
          <text class="comment-text">{{item.content}}</text>
          <view wx:if="{{(isAdmin || (hasSession && getCurrentUserId() === item.authorId))}}" class="comment-actions">
            <text class="comment-action" bindtap="deleteComment" data-commentid="{{item.commentId}}">删除</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="comment-input-bar">
    <input 
      wx:if="{{allowComments}}"
      class="comment-input" 
      placeholder="发表评论..." 
      value="{{newComment}}"
      bindinput="onCommentInput"
      confirm-type="send"
      bindconfirm="submitComment"
    />
    <button wx:if="{{allowComments}}" class="send-btn" bindtap="submitComment">发送</button>
    <text wx:else class="comments-closed">评论已关闭</text>
  </view>
</view>