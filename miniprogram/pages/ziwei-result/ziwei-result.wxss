.tab-spacer {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

.container {
  min-height: 100vh;
  background: #f0f2f5;
  display: flex;
  flex-direction: column;
}

.tab-bar {
  display: flex;
  background: #fff;
  padding: 16rpx 24rpx;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666;
  border-radius: 12rpx;
  background: #f5f6f8;
}

.tab-item.active {
  background: linear-gradient(135deg, #4a6fa5 0%, #2c3e6b 100%);
  color: #fff;
  font-weight: bold;
}

.content {
  flex: 1;
  height: 0;
  padding: 24rpx;
}

.result-section {
  padding-bottom: 24rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.card-header {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.date-card {
  background: linear-gradient(135deg, #f5f8ff 0%, #eef3fa 100%);
}

.info-list {
  padding: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #888;
  flex-shrink: 0;
  width: 160rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  text-align: right;
  flex: 1;
}

.info-block {
  text-align: left;
  line-height: 1.5;
}

.pattern-list {
  padding: 16rpx 24rpx 24rpx;
}

.pattern-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.pattern-item:last-child {
  border-bottom: none;
}

.pattern-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.pattern-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.pattern-type {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #eef3ff;
  color: #4a6fa5;
}

.pattern-type.bad {
  background: #fff0f0;
  color: #c44;
}

.pattern-desc {
  display: block;
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
}

.pattern-source {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.chart-card .card-header {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.chart-subtitle {
  font-size: 22rpx;
  color: #999;
  font-weight: normal;
}

.chart-board {
  padding: 16rpx;
  background: linear-gradient(145deg, #3d2817 0%, #2a1a0e 100%);
  border-radius: 0 0 20rpx 20rpx;
}

.chart-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: repeat(4, minmax(148rpx, auto));
  gap: 6rpx;
  position: relative;
}

.chart-palace {
  background: linear-gradient(180deg, #fffdf8 0%, #f8f2e8 100%);
  border: 2rpx solid #c4a574;
  border-radius: 6rpx;
  padding: 8rpx 6rpx;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.6);
}

.chart-palace.is-soul {
  border-color: #8b2942;
  background: linear-gradient(180deg, #fff5f7 0%, #fce8ec 100%);
  box-shadow: 0 0 0 2rpx rgba(139, 41, 66, 0.25);
}

.chart-palace.is-body {
  border-color: #b8860b;
  background: linear-gradient(180deg, #fffbf0 0%, #fdf3d8 100%);
}

.cp-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 4rpx;
  border-bottom: 1rpx solid rgba(196, 165, 116, 0.5);
  padding-bottom: 4rpx;
  margin-bottom: 4rpx;
}

.cp-branch {
  font-size: 20rpx;
  color: #8b6914;
  font-weight: bold;
  flex-shrink: 0;
  width: 28rpx;
}

.cp-title-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4rpx;
  min-width: 0;
}

.cp-name {
  font-size: 22rpx;
  font-weight: bold;
  color: #3d2817;
  line-height: 1.2;
}

.cp-badge {
  font-size: 16rpx;
  padding: 0 6rpx;
  border-radius: 4rpx;
  color: #fff;
  line-height: 1.4;
}

.cp-badge.soul {
  background: #8b2942;
}

.cp-badge.body {
  background: #b8860b;
}

.cp-gz {
  font-size: 18rpx;
  color: #8b7355;
  flex-shrink: 0;
}

.cp-stars {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  overflow: hidden;
}

.cp-major,
.cp-minor {
  display: flex;
  flex-wrap: wrap;
  gap: 2rpx 4rpx;
}

.cp-star {
  font-size: 18rpx;
  line-height: 1.3;
  word-break: break-all;
}

.cp-star.major {
  color: #6b1d3a;
  font-weight: 600;
}

.cp-star.minor {
  color: #5a6b7a;
  font-size: 16rpx;
}

.cp-empty {
  font-size: 18rpx;
  color: #b0a090;
  text-align: center;
  padding-top: 8rpx;
}

.chart-center {
  grid-column: 2 / 4;
  grid-row: 2 / 4;
  background: linear-gradient(145deg, #f5ebe0 0%, #e8dcc8 100%);
  border: 3rpx solid #8b6914;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 8rpx;
  text-align: center;
  box-shadow: inset 0 0 24rpx rgba(139, 105, 20, 0.12);
}

.cc-title {
  font-size: 22rpx;
  color: #8b6914;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.cc-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #3d2817;
  margin-bottom: 8rpx;
}

.cc-line {
  font-size: 20rpx;
  color: #5c4a32;
  line-height: 1.5;
}

.cc-palaces {
  margin-top: 10rpx;
  padding-top: 8rpx;
  border-top: 1rpx dashed #c4a574;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cc-palaces text {
  font-size: 20rpx;
  color: #6b1d3a;
  font-weight: 600;
}

.daxian-list {
  padding: 16rpx 24rpx 24rpx;
}

.daxian-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.daxian-age {
  font-size: 24rpx;
  color: #4a6fa5;
  width: 120rpx;
}

.daxian-palace {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.daxian-gz {
  font-size: 24rpx;
  color: #888;
}

.text-block {
  padding: 24rpx;
}

.block-title {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #4a6fa5;
  margin: 16rpx 0 8rpx;
}

.block-title:first-child {
  margin-top: 0;
}

.block-body {
  display: block;
  font-size: 26rpx;
  color: #444;
  line-height: 1.6;
  white-space: pre-wrap;
}

.palace-brief-list {
  padding: 0 24rpx 24rpx;
}

.palace-brief {
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.brief-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.brief-body {
  display: block;
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  white-space: pre-wrap;
}

.daxian-classic-list {
  padding: 0 24rpx 24rpx;
}

.daxian-classic {
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.dc-theme {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.dc-detail {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.summary-card .summary-text {
  display: block;
  padding: 24rpx;
  font-size: 28rpx;
  color: #444;
  line-height: 1.7;
}

.share-hint {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 0 16rpx;
}
