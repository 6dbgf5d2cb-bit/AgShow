.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 32rpx 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  font-size: 36rpx;
  color: #fff;
}

.header .title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.placeholder {
  width: 64rpx;
}

.content {
  height: calc(100vh - 180rpx);
  padding: 24rpx;
}

.result-section {
  padding-bottom: 120rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.card-header {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.date-card {
  background: linear-gradient(135deg, #fff5e6 0%, #ffe6cc 100%);
}

.date-info {
  padding: 24rpx;
}

.bazi-card {
  background: linear-gradient(135deg, #fefefe 0%, #f5f7fa 100%);
}

.bazi-grid {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bazi-row {
  margin-bottom: 16rpx;
}

.day-row {
  margin: 24rpx 0;
}

.bazi-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.bazi-cell .gan {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.bazi-cell .zhi {
  font-size: 28rpx;
  color: #666;
  margin-top: 4rpx;
}

.day-gan {
  font-size: 64rpx !important;
  color: #667eea !important;
}

.day-zhi {
  font-size: 36rpx !important;
  color: #764ba2 !important;
}

.bazi-info {
  padding: 0 32rpx 32rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
}

.info-value-block {
  font-weight: normal;
  line-height: 1.6;
  text-align: right;
  flex: 1;
  max-width: 70%;
}

.xiyong-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  gap: 16rpx;
}

.xiyong-badge {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
}

.xiyong-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}

.xiyong-label {
  font-size: 26rpx;
  color: #999;
}

.analysis-text {
  padding: 24rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-wrap;
}

.wuxing-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx;
  gap: 16rpx;
}

.wuxing-item {
  flex: 1;
  min-width: calc(50% - 8rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.wuxing-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.wuxing-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.wuxing-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.symptoms-list {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx;
  gap: 12rpx;
}

.symptom-tag {
  padding: 12rpx 24rpx;
  background: rgba(102, 126, 234, 0.1);
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #667eea;
}

.suggestions-list {
  padding: 24rpx;
}

.suggestion-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.suggestion-item:last-child {
  border-bottom: none;
}

.suggestion-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #52c41a;
  border-radius: 50%;
  font-size: 24rpx;
  color: #fff;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.suggestion-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.reference-card {
  background: linear-gradient(135deg, #fffef9 0%, #fff9e6 100%);
}

.detailed-analysis {
  border-left: 6rpx solid #667eea;
}

.analysis-section {
  padding: 24rpx;
}

.analysis-section .analysis-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  text-align: justify;
}

.reference-list {
  padding: 24rpx;
}

.reference-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5e6c8;
}

.reference-item:last-child {
  border-bottom: none;
}

.reference-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.reference-info {
  flex: 1;
}

.reference-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.reference-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.highlight-card {
  background: linear-gradient(135deg, #f0f4ff 0%, #e8f5e9 100%);
}

.pattern-summary {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.6;
  padding: 0 24rpx 24rpx;
}

.body-part-card .meridian-tag {
  font-size: 22rpx;
  color: #888;
  margin-left: 12rpx;
}

.part-symptoms {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 24rpx 16rpx;
}

.mini-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  background: #eef2ff;
  color: #667eea;
  border-radius: 8rpx;
}

.classic-quote-box {
  margin: 0 24rpx 16rpx;
  padding: 16rpx 20rpx;
  background: #fffef5;
  border-left: 6rpx solid #c9a227;
  border-radius: 8rpx;
}

.quote-label {
  display: block;
  font-size: 22rpx;
  color: #c9a227;
  margin-bottom: 8rpx;
}

.quote-text {
  font-size: 24rpx;
  color: #5a4a2a;
  line-height: 1.6;
}

.pre-wrap {
  white-space: pre-wrap;
  word-break: break-word;
}

.organ-block {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.organ-block:last-child {
  border-bottom: none;
}

.organ-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.organ-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.organ-wuxing {
  font-size: 24rpx;
  color: #667eea;
  padding: 4rpx 12rpx;
  background: #eef2ff;
  border-radius: 8rpx;
}

.organ-status {
  font-size: 24rpx;
  color: #e67e22;
}

.organ-theory {
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
}

.classic-subtitle {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #667eea;
  padding: 0 24rpx 12rpx;
}

.caution-card {
  background: #fff8e6;
  border: 1rpx solid #ffe58f;
}

.caution-text {
  font-size: 26rpx;
  color: #ad6800;
  line-height: 1.7;
  padding: 0 24rpx 24rpx;
}

.footer-space {
  height: calc(180rpx + env(safe-area-inset-bottom));
}

.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom) + 16rpx) !important;
  z-index: 9998;
  padding: 16rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.btn-share {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  border: 2rpx solid #667eea;
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #667eea;
  margin: 0;
  padding: 0;
}

.btn-share::after {
  border: none;
}

.btn-primary {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 44rpx;
  border: none;
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  margin: 0;
  padding: 0;
}

.btn-primary::after {
  border: none;
}

/* 渊海子平诗诀样式 */
.poem-section {
  padding: 24rpx;
  background: linear-gradient(135deg, #fffef9 0%, #fdf5e6 100%);
  border-radius: 16rpx;
  margin: 0 24rpx 24rpx;
}

.poem-text {
  font-size: 28rpx;
  color: #5a4a2a;
  line-height: 2;
  text-align: center;
  font-family: '楷体', 'KaiTi', serif;
}

.main-reference {
  background: rgba(255, 215, 0, 0.1);
  padding: 16rpx;
  margin: -24rpx;
  margin-bottom: 0;
  border-bottom: 2rpx solid #ffd700;
}

.second-reference {
  background: rgba(102, 126, 234, 0.1);
  padding: 16rpx;
  margin: -24rpx;
  margin-bottom: 0;
  border-bottom: 2rpx solid #667eea;
}

/* 《滴天髓》卡片样式 */
.ditian-card {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
}

.ditian-card .card-header {
  background: rgba(255, 255, 255, 0.1);
  border-bottom: none;
}

.ditian-card .card-title {
  color: #e94560;
}

.ditian-card .poem-section {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(233, 69, 96, 0.3);
}

.ditian-card .poem-text {
  color: #eaeaea;
  font-family: '楷体', 'KaiTi', serif;
  font-size: 26rpx;
}

/* 性情论样式 */
.xingqing-section {
  padding: 16rpx 0;
}

.xingqing-item {
  padding: 16rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.xingqing-item:last-child {
  margin-bottom: 0;
}

.xingqing-item.positive {
  background: rgba(82, 196, 26, 0.1);
  border-left: 6rpx solid #52c41a;
}

.xingqing-item.negative {
  background: rgba(245, 108, 108, 0.1);
  border-left: 6rpx solid #f56c6c;
}

.xingqing-label {
  font-weight: bold;
  font-size: 26rpx;
  margin-right: 8rpx;
}

.xingqing-item.positive .xingqing-label {
  color: #52c41a;
}

.xingqing-item.negative .xingqing-label {
  color: #f56c6c;
}

.xingqing-content {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}

/* 典籍详论卡片（穷通宝鉴 / 子平真诠 / 三命通会·千里命稿） */
.classic-card .card-header {
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.card-subtitle {
  font-size: 22rpx;
  color: #999;
  font-weight: normal;
}

.analysis-label {
  display: block;
  font-size: 24rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 8rpx;
}

.geju-badge-row {
  padding: 0 24rpx 16rpx;
}

.geju-badge {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 32rpx;
}

.subsection-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  padding: 24rpx 24rpx 12rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 8rpx;
}

.dayun-item,
.liunian-item {
  margin: 0 24rpx 20rpx;
  padding: 20rpx;
  background: #f8f9fc;
  border-radius: 12rpx;
  border-left: 6rpx solid #667eea;
}

.dayun-header,
.liunian-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.dayun-age,
.liunian-year {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.dayun-ganzhi,
.liunian-ganzhi {
  font-size: 28rpx;
  font-weight: bold;
  color: #667eea;
}

.dayun-shishen,
.liunian-shishen {
  font-size: 22rpx;
  color: #888;
  background: #eee;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.dayun-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-left: auto;
}

.dayun-tag--good {
  background: rgba(82, 196, 26, 0.15);
  color: #52c41a;
}

.dayun-tag--warn {
  background: rgba(250, 173, 20, 0.15);
  color: #fa8c16;
}

.dayun-tag--mid {
  background: rgba(102, 126, 234, 0.15);
  color: #667eea;
}

.dayun-detail,
.liunian-detail {
  display: block;
  font-size: 26rpx;
  color: #555;
  line-height: 1.65;
}

.dayun-caution {
  display: block;
  font-size: 24rpx;
  color: #fa8c16;
  margin-top: 10rpx;
  line-height: 1.5;
}

.liunian-theme {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #764ba2;
  margin-bottom: 8rpx;
}

.liunian-relation {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}