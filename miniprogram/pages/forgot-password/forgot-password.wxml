<view class="container">
  <page-header bind:back="goToLogin" title="找回密码" />

  <view class="form-section">
    <view wx:if="{{errorMessage}}" class="error-message">
      <text>{{errorMessage}}</text>
    </view>
    <view wx:if="{{successMessage}}" class="success-message">
      <text>{{successMessage}}</text>
    </view>

    <view class="channel-tabs">
      <view
        class="channel-tab {{channel === 'sms' ? 'active' : ''}}"
        bindtap="setChannel"
        data-channel="sms"
      >手机短信</view>
      <view
        class="channel-tab {{channel === 'email' ? 'active' : ''}}"
        bindtap="setChannel"
        data-channel="email"
      >邮箱验证</view>
    </view>

    <view wx:if="{{channel === 'sms'}}" class="input-item">
      <text class="label">注册手机号</text>
      <input
        class="input-field"
        type="number"
        maxlength="11"
        placeholder="请输入11位手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view wx:if="{{channel === 'email'}}" class="input-item">
      <text class="label">注册邮箱</text>
      <input
        class="input-field"
        placeholder="请输入注册时填写的邮箱"
        value="{{email}}"
        bindinput="onEmailInput"
      />
    </view>

    <view class="code-row">
      <view class="input-item code-input">
        <text class="label">验证码</text>
        <input
          class="input-field"
          type="number"
          maxlength="6"
          placeholder="6位验证码"
          value="{{code}}"
          bindinput="onCodeInput"
        />
      </view>
      <button
        class="send-code-btn"
        bindtap="sendCode"
        disabled="{{countdown > 0 || sendingCode}}"
        loading="{{sendingCode}}"
      >
        {{countdown > 0 ? countdown + 's' : '获取验证码'}}
      </button>
    </view>

    <view wx:if="{{debugCode}}" class="debug-hint">
      <text>开发模式验证码：{{debugCode}}</text>
    </view>

    <view class="input-item">
      <text class="label">新密码</text>
      <input
        class="input-field"
        placeholder="不少于6位"
        value="{{newPassword}}"
        bindinput="onNewPasswordInput"
        type="{{showPassword ? 'text' : 'password'}}"
      />
      <view class="input-action" bindtap="togglePassword">
        <text>{{showPassword ? '🙈' : '👁️'}}</text>
      </view>
    </view>

    <view class="input-item">
      <text class="label">确认新密码</text>
      <input
        class="input-field"
        placeholder="再次输入新密码"
        value="{{confirmPassword}}"
        bindinput="onConfirmPasswordInput"
        type="{{showConfirmPassword ? 'text' : 'password'}}"
      />
      <view class="input-action" bindtap="toggleConfirmPassword">
        <text>{{showConfirmPassword ? '🙈' : '👁️'}}</text>
      </view>
    </view>

    <button class="btn-primary" bindtap="submitReset" loading="{{loading}}" disabled="{{loading}}">
      确认重置
    </button>

    <view class="divider">
      <view class="divider-line"></view>
      <text class="divider-text">或</text>
      <view class="divider-line"></view>
    </view>

    <button
      class="btn-wechat-phone"
      open-type="getPhoneNumber"
      bindgetphonenumber="onWechatPhoneReset"
      loading="{{wxPhoneLoading}}"
      disabled="{{wxPhoneLoading || loading}}"
    >
      微信验证手机号快速重置
    </button>
    <text class="hint">微信授权手机号须与注册手机号一致；不一致时请使用上方短信验证码</text>
  </view>

  <view class="tab-spacer"></view>
  <app-tab-bar />
</view>
