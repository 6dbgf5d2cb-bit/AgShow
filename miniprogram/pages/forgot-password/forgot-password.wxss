.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f4ff 0%, #f5f5f5 40%);
  padding-bottom: 48rpx;
}

.form-section {
  margin: 24rpx 32rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
}

.error-message {
  background: #fff2f0;
  color: #ff4d4f;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
}

.success-message {
  background: #f6ffed;
  color: #52c41a;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
}

.channel-tabs {
  display: flex;
  margin-bottom: 32rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 6rpx;
}

.channel-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
}

.channel-tab.active {
  background: #fff;
  color: #667eea;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.input-item {
  margin-bottom: 24rpx;
  position: relative;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.input-field {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f8f9fc;
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input-action {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  font-size: 32rpx;
}

.code-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.code-input {
  flex: 1;
  margin-bottom: 0;
}

.send-code-btn {
  flex-shrink: 0;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  background: #667eea;
  color: #fff;
  border-radius: 16rpx;
  border: none;
  margin-bottom: 24rpx;
}

.send-code-btn::after {
  border: none;
}

.send-code-btn[disabled] {
  background: #ccc;
  color: #fff;
}

.debug-hint {
  font-size: 24rpx;
  color: #fa8c16;
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: #fff7e6;
  border-radius: 12rpx;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  border: none;
  margin-top: 16rpx;
}

.btn-primary::after {
  border: none;
}

.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0 24rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e8e8e8;
}

.divider-text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #999;
}

.btn-wechat-phone {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07c160;
  color: #fff;
  border-radius: 44rpx;
  font-size: 28rpx;
  border: none;
}

.btn-wechat-phone::after {
  border: none;
}

.hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 16rpx;
  line-height: 1.5;
}
