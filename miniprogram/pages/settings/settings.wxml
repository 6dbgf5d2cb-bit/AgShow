<view class="container">
  <page-header title="设置" />

  <view class="section">
    <view class="section-header">
      <text class="section-title">个人资料</text>
    </view>
    <view class="section-content">
      <view class="setting-item" bindtap="goToProfileEdit">
        <view class="item-icon">👤</view>
        <view class="item-info">
          <text class="item-label">编辑个人资料</text>
          <text class="item-desc">修改昵称、性别、生日等信息</text>
        </view>
        <view class="item-arrow">→</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">账号安全</text>
    </view>
    <view class="section-content password-section">
      <view class="input-item">
        <text class="label">当前密码</text>
        <input
          class="input-field"
          password="{{!showOldPassword}}"
          value="{{oldPassword}}"
          placeholder="请输入当前密码"
          bindinput="onOldPasswordInput"
        />
        <text class="toggle-eye" bindtap="toggleOldPasswordVisible">{{showOldPassword ? '🙈' : '👁️'}}</text>
      </view>

      <view class="input-item">
        <text class="label">新密码</text>
        <input
          class="input-field"
          password="{{!showNewPassword}}"
          value="{{newPassword}}"
          placeholder="请输入新密码（不少于6位）"
          bindinput="onNewPasswordInput"
        />
        <text class="toggle-eye" bindtap="toggleNewPasswordVisible">{{showNewPassword ? '🙈' : '👁️'}}</text>
      </view>

      <view class="input-item">
        <text class="label">确认新密码</text>
        <input
          class="input-field"
          password="{{!showConfirmPassword}}"
          value="{{confirmPassword}}"
          placeholder="请再次输入新密码"
          bindinput="onConfirmPasswordInput"
        />
        <text class="toggle-eye" bindtap="toggleConfirmPasswordVisible">{{showConfirmPassword ? '🙈' : '👁️'}}</text>
      </view>

      <button class="password-btn" loading="{{passwordLoading}}" bindtap="submitPasswordChange">
        修改密码
      </button>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">页面布局</text>
      <view class="refresh-btn" bindtap="refreshLayout">
        <text>刷新</text>
      </view>
    </view>
    <view class="section-content">
      <view class="layout-hint">
        <text>您可以调整有权限访问的模块在首页的显示顺序和启用状态</text>
      </view>
      <view wx:for="{{modules}}" wx:key="id" class="module-item">
        <view class="module-checkbox" bindtap="toggleModule" data-id="{{item.id}}">
          <view class="checkbox {{item.enabled ? 'checked' : ''}}">
            <text wx:if="{{item.enabled}}" class="check-icon">✓</text>
          </view>
        </view>
        <view class="module-info">
          <view class="module-icon">{{item.icon}}</view>
          <text class="module-name">{{item.name}}</text>
        </view>
        <view class="module-actions">
          <view class="position-info">
            <text>位置: {{item.position + 1}}</text>
          </view>
          <view class="edit-btn" bindtap="startEditPosition" data-id="{{item.id}}">
            <text>调整位置</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{showEditModal}}" class="modal-overlay" bindtap="closeEditModal">
    <view class="modal-content" catchtap="noop">
      <view class="modal-header">
        <text>调整位置</text>
        <view class="modal-close" bindtap="closeEditModal">×</view>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">输入新位置（1-{{totalModules}}）</text>
          <input 
            class="form-input" 
            type="number" 
            value="{{editingPosition}}"
            bindinput="onPositionInput"
            placeholder="请输入位置"
          />
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-secondary" bindtap="closeEditModal">取消</button>
        <button class="btn-primary" bindtap="confirmPositionChange">确认</button>
      </view>
    </view>
  </view>
</view>